    "@tailwindcss/typography": "^0.5.12",
    "@tanstack/react-query": "^5.28.14",
    "@tanstack/react-query-devtools": "^5.28.14",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dompurify": "^3.1.0",
    "embla-carousel-react": "^8.0.1",
